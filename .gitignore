# Benchmark reference material containing song text: the lyric sheet the manifest
# binds for will-death-poetry, and the annotation files, whose schema stores each
# line's text for its integrity check (scripts/lib/syncBenchmark.mjs:18).
# ADR-0004 wants hashes here instead; until the schema stores hashes, these stay
# local like the other whole-song text (tests/privateFixtures.mjs).
benchmarks/sync/will-death-lyrics.txt
benchmarks/sync/annotations/akfg-first-take.json
benchmarks/sync/annotations/will-death-poetry.json
