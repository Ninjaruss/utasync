# onnxruntime-node's postinstall downloads a CUDA execution-provider tarball from a GitHub
# release, and only on Linux x64 — which is why this breaks CI and not a macOS checkout. That
# asset now 404s (onnxruntime-linux-x64-gpu-1.21.0.tgz), so `npm ci` fails outright on the
# runner before typecheck or tests get a chance to run.
#
# Skipping it is correct rather than a workaround: this app runs @huggingface/transformers in
# the BROWSER via WebGPU and declares `onnxruntime-web` for that. `onnxruntime-node` arrives
# only transitively, and its CUDA provider is never loaded. The package still installs and
# works; only the GPU binaries are skipped.
#
# npm turns this key into npm_config_onnxruntime_node_install_cuda, which is what the script
# reads (node_modules/.../onnxruntime-node/script/install.js, parseInstallCudaFlag).
onnxruntime-node-install-cuda=skip
